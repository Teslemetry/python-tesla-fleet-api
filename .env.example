# Copy to .env, chmod 600 .env, edit locally, then export (the service does not auto-load it).
TESLA_REGION=cn
TESLA_CLIENT_ID=replace-with-cn-application-id
TESLA_CLIENT_SECRET=replace-with-cn-application-secret
TESLA_REDIRECT_URI=https://your-registered-domain.example/tesla/callback
TESLA_ALLOWED_VINS=REPLACE_WITH_YOUR_17_CHARACTER_VIN
# Use the same absolute private directory for login, serve and approve.
TESLA_STATE_DIR=/absolute/private/path/tesla-mcp-state
TESLA_TOOLS=list_vehicles,get_vehicle_state
TESLA_ENABLE_COMMANDS=false
TESLA_ENABLE_WAYPOINTS=false
# Existing P-256 command key, mode 0600. Required for signed navigation.
# TESLA_PRIVATE_KEY=/absolute/private/path/private-key.pem
MCP_PORT=8000
# Generate a separate random value of at least 32 ASCII characters; never a Tesla token.
MCP_BEARER_TOKEN=
