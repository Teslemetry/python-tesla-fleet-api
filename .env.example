# 复制为 .env，执行 chmod 600 .env，再编辑并导入当前终端；服务不会自动加载该文件。
# 所有占位值需替换。含特殊字符的值请用合适的 shell 引号包裹。
# 中国区使用 cn；应用和账号必须与区域匹配。
TESLA_REGION=cn
# 中国区开发者应用标识与密钥，不是 Tesla 账号密码。
TESLA_CLIENT_ID=replace-with-cn-application-id
TESLA_CLIENT_SECRET=replace-with-cn-application-secret
# 已在开发者应用注册的 HTTPS 回调地址。
TESLA_REDIRECT_URI=https://your-registered-domain.example/tesla/callback
# 允许访问的车辆 VIN（大写 17 位），多辆车使用英文逗号分隔，不支持通配符。
TESLA_ALLOWED_VINS=REPLACE_WITH_YOUR_17_CHARACTER_VIN
# 私密状态目录：login、serve、approve 必须使用同一个绝对路径；目录权限 0700。
TESLA_STATE_DIR=/absolute/private/path/tesla-mcp-state
# 默认只允许列表和不含位置的状态查询；需要其他能力时再按文档添加配置名。
TESLA_TOOLS=list_vehicles,get_vehicle_state
# 写操作总开关：默认 false；只有精确的小写 true 才启用，启用后仍需人工确认。
TESLA_ENABLE_COMMANDS=false
# 多途经点实验开关：有效载荷和中国区实车效果尚未验证，默认关闭。
TESLA_ENABLE_WAYPOINTS=false
# 已注册的 P-256 签名私钥，文件权限 0600；签名导航需要此配置。
# TESLA_PRIVATE_KEY=/absolute/private/path/private-key.pem
# 本机 HTTP MCP 端口，地址默认为 http://127.0.0.1:8000/mcp。
MCP_PORT=8000
# 独立生成至少 32 位 ASCII 无空白随机密钥；不能填写 Tesla 令牌；HTTP 启动时不能为空。
MCP_BEARER_TOKEN=
